# Optional. Copy this file to .env in YOUR podcast folder (not the kit folder) and fill it in.
# Without these, discovery uses Apple Podcasts search only, which needs no key.
#
# Podcast Index is free and open: sign up at https://api.podcastindex.org/signup
# The key and secret are emailed to you. Never share them or commit .env to git.
PODCASTINDEX_KEY=
PODCASTINDEX_SECRET=
